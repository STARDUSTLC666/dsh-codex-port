{
  "name": "dsh-codex-port",
  "version": "0.3.0",
  "description": "把本机 Codex 技能转换为 DSH 可使用的技能。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "codex",
    "skills",
    "migration",
    "dsh-plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-codex-port.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-codex-port/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-codex-port#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0"
}
