{
  "name": "dsh-codex-port",
  "version": "0.4.19",
  "description": "DeepSeek Harness Codex 技能移植插件：离线预览导入、保留调用策略与许可、检测同名冲突。欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/update-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/plugin-icon.webp"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp",
    "locale"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-updates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "codex",
    "skills",
    "migration",
    "dsh-plugin",
    "deepseek",
    "ai-agent",
    "agent-skills",
    "技能移植"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "@stardustlc/dsh-updates": "0.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-codex-port.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-codex-port/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-codex-port#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "icon": "./assets/plugin-icon.webp"
}
